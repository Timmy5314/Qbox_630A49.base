_external/

# Oude handmatige cfg-backup (git is nu de backup, bevat secrets)
server.cfg.bkp

# Discord-bot: afhankelijkheden en het token
discord-bot/node_modules/
discord-bot/.env

# --- carmap: afbeeldingen-pack (35k+ bestanden, ~370 MB) ---
# De code (fxmanifest.lua, server.lua) WEL tracken, de afbeeldingen NIET —
# die horen niet in git. Ze staan al op de server-schijf.
resources/carmap/clothes/
resources/carmap/items/
resources/carmap/vehicle/
resources/carmap/*.webp
